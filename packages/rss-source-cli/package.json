{
  "name": "rss-source-cli",
  "version": "0.1.0",
  "description": "Agent-friendly CLI for a self-hosted RSS Source service.",
  "type": "module",
  "bin": {
    "rss-source": "dist/index.js",
    "rss-source-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "rss",
    "atom",
    "feed",
    "agent",
    "cli",
    "folo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WesternFastShooters/rss-source.git",
    "directory": "packages/rss-source-cli"
  },
  "bugs": {
    "url": "https://github.com/WesternFastShooters/rss-source/issues"
  },
  "homepage": "https://github.com/WesternFastShooters/rss-source#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
