# RSS_SOURCE_URL: Public RSS Source service URL.
RSS_SOURCE_URL=

# RSS_SOURCE_API_KEY: Bearer API key configured as APP_API_KEY on the server.
RSS_SOURCE_API_KEY=

# CF_ACCESS_CLIENT_ID: Optional Cloudflare Access service-token client ID.
CF_ACCESS_CLIENT_ID=

# CF_ACCESS_CLIENT_SECRET: Optional Cloudflare Access service-token secret.
CF_ACCESS_CLIENT_SECRET=
