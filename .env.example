# IMAGE_NAME: GHCR image path produced by GitHub Actions.
IMAGE_NAME=

# IMAGE_TAG: Image tag to deploy, such as latest or sha-<commit>.
IMAGE_TAG=

# POSTGRES_DB: PostgreSQL database name.
POSTGRES_DB=

# POSTGRES_USER: PostgreSQL application user.
POSTGRES_USER=

# POSTGRES_PASSWORD: Strong random PostgreSQL password.
POSTGRES_PASSWORD=

# REDIS_PASSWORD: Strong random password used only by RSSHub and Redis.
REDIS_PASSWORD=

# APP_API_KEY: Strong random Bearer token, at least 32 characters, for REST and MCP.
APP_API_KEY=

# ALLOWED_HOSTS: Comma-separated public hostname plus localhost addresses accepted in Host headers.
ALLOWED_HOSTS=

# ALLOWED_ORIGINS: Comma-separated browser Origin hostnames allowed to call the service.
ALLOWED_ORIGINS=

# RSSHUB_BASE_URL: Internal RSSHub service URL used to expand rsshub:// subscriptions.
RSSHUB_BASE_URL=

# FETCH_ALLOW_PRIVATE_HOSTS: Comma-separated internal hostnames explicitly allowed by the SSRF policy.
FETCH_ALLOW_PRIVATE_HOSTS=

# DB_POOL_MAX: Maximum PostgreSQL connections used by the application.
DB_POOL_MAX=

# FETCH_CONCURRENCY: Maximum feeds refreshed concurrently.
FETCH_CONCURRENCY=

# DEFAULT_FETCH_INTERVAL_MINUTES: Default refresh interval for new subscriptions.
DEFAULT_FETCH_INTERVAL_MINUTES=

# SCHEDULER_TICK_SECONDS: How often the scheduler looks for due feeds.
SCHEDULER_TICK_SECONDS=

# FETCH_TIMEOUT_MS: Per-request feed fetch timeout.
FETCH_TIMEOUT_MS=

# FETCH_MAX_BYTES: Maximum accepted feed response size.
FETCH_MAX_BYTES=

# LOG_LEVEL: Application log level.
LOG_LEVEL=

# TZ: Container timezone.
TZ=
